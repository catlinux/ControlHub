# Configuración de ejemplo de ControlHub.
# Nunca introduzcas secretos reales en este archivo.

APP_ENV=development
APP_URL=http://localhost
DATABASE_URL=sqlite:///data/controlhub.db
SESSION_SECRET=

# Solo se usa para crear el primer administrador si todavía no existe.
CONTROLHUB_ADMIN_USERNAME=
CONTROLHUB_ADMIN_PASSWORD=

CONTROLHUB_HOST=127.0.0.1
CONTROLHUB_PORT=8008
